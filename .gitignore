# --- Models & data (large / sensitive; do not commit) ---
models/**/*.bin
models/**/*.pt
models/**/*.pth
models/**/*.onnx
data/samples/*
data/test/*
!data/**/.gitkeep

# --- Audio (never commit raw voice) ---
*.wav
*.mp3
*.flac
*.webm
*.ogg

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
