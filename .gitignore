# --- Secrets / env ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.db
*.sqlite3

# --- Node / frontend ---
node_modules/
dist/
