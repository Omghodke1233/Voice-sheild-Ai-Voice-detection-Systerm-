# ---------------------------------------------------------------------------
# VoiceShield environment configuration
# Copy this file to `.env` and adjust values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- General ---
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
# Local dev (default): SQLite, no external service needed.
DATABASE_URL=sqlite:///./voiceshield.db
# Production / Docker (PostgreSQL) example:
# DATABASE_URL=postgresql+psycopg://voiceshield:voiceshield@db:5432/voiceshield

# --- WebSocket ---
WEBSOCKET_TIMEOUT=60

# --- Audio contract ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SECONDS=2.0
AUDIO_OVERLAP_SECONDS=1.0

# --- AI module thresholds ---
VOICE_THRESHOLD=0.5
SPEAKER_THRESHOLD=0.5

# --- Risk fusion thresholds ---
RISK_THRESHOLD_LOW=0.25
RISK_THRESHOLD_MEDIUM=0.50
RISK_THRESHOLD_HIGH=0.75

# --- Model paths ---
MODEL_PATH_VOICE=./models/voice_detector
MODEL_PATH_SPEAKER=./models/speaker

# --- CORS (frontend dev server origins, comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
